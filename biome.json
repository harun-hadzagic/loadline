{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.csv",
      "!**/data/raw",
      "!packages/intake/fixtures",
      "!bench/results",
      "!apps/web/next-env.d.ts",
      "!SPEC.md",
      "!CLAUDE.md",
      "!**/*.md",
      "!apps/web/src/components/ui",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "pg": "Only packages/db may open database connections. Use withTenant from @loadline/db.",
              "pg-pool": "Only packages/db may open database connections. Use withTenant from @loadline/db.",
              "drizzle-orm/node-postgres": "Only packages/db may open database connections. Use withTenant from @loadline/db.",
              "postgres": "Only packages/db may open database connections. Use withTenant from @loadline/db.",
              "@loadline/db/testing": "Application code never opens its own pool. Use withTenant from @loadline/db."
            }
          }
        }
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["bench/**", "e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**/*.tsx", "apps/web/**/*.ts"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "e2e/**", "bench/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
