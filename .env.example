# Loadline local configuration. Copy to .env; docker compose and the scripts read it.
# Everything here is for local use only. Nothing in this file is a real secret.

# --- Database image -------------------------------------------------------
# The official postgis/postgis:18-3.6 image is published for linux/amd64 only.
# On Apple Silicon, build a native image once with `pnpm db:image` and uncomment:
# POSTGIS_IMAGE=loadline/postgis:18-3.6
POSTGIS_IMAGE=postgis/postgis:18-3.6

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loadline
POSTGRES_PASSWORD=postgres-local

# Role passwords. The bootstrap step creates the roles with these.
LOADLINE_OWNER_PASSWORD=owner-local
LOADLINE_APP_PASSWORD=app-local
LOADLINE_AUTH_PASSWORD=auth-local
LOADLINE_STREAM_PASSWORD=stream-local

# Connection strings derived from the above. Keep them in step.
DATABASE_URL_SUPER=postgres://postgres:postgres-local@localhost:5432/loadline
DATABASE_URL_OWNER=postgres://loadline_owner:owner-local@localhost:5432/loadline
DATABASE_URL_APP=postgres://loadline_app:app-local@localhost:5432/loadline
DATABASE_URL_AUTH=postgres://loadline_auth:auth-local@localhost:5432/loadline
DATABASE_URL_STREAM=postgres://loadline_stream:stream-local@localhost:5432/loadline

# The test database (docker compose --profile test up -d db-test). tmpfs, port 5433.
TEST_DB_PORT=5433
TEST_DATABASE_URL_SUPER=postgres://postgres:postgres-local@localhost:5433/loadline_test

# --- Demo data ------------------------------------------------------------
# Every seeded demo user signs in with this password. Local use only.
DEMO_PASSWORD=loadline-demo

# --- App ------------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-this-is-a-local-dev-secret-0123456789
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Simulator ------------------------------------------------------------
# Service token the simulator sends to POST /api/positions.
SIMULATOR_TOKEN=sim-local-token-change-me
SIMULATOR_SPEED_FACTOR=60
SIMULATOR_INTERVAL_MS=3000
SIMULATOR_TARGET_URL=http://localhost:3000

# --- Intake ---------------------------------------------------------------
# Leave empty. Nothing in this build calls the Anthropic API. When set later,
# the new-load page uses the Claude extractor and `pnpm eval:intake --extractor claude --live` works.
ANTHROPIC_API_KEY=
